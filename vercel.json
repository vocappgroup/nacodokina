{
  "buildCommand": "",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/og.js": {
      "includeFiles": "{public/picks.json,fonts/**,node_modules/harfbuzzjs/hb.wasm,node_modules/satori/yoga.wasm}",
      "memory": 1024,
      "maxDuration": 10
    },
    "api/share.js": {
      "includeFiles": "public/picks.json",
      "maxDuration": 5
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/k/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/k/:slug/:film",
      "destination": "/api/share?k=:slug&f=:film"
    }
  ]
}
